{
  "name": "harness-session-manager",
  "version": "1.0.0",
  "description": "One terminal hub for Claude Code, OpenCode, and future coding harness sessions.",
  "type": "module",
  "bin": { "sessions": "./src/index.mjs", "hsm": "./src/index.mjs" },
  "scripts": {
    "start": "node src/index.mjs",
    "preview": "node src/index.mjs --preview",
    "check": "node --check src/*.mjs",
    "test": "node --test tests/*.test.mjs && npm run check"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.204",
    "@opentui/core": "^0.3.0"
  },
  "engines": { "node": ">=20" },
  "license": "MIT"
}
